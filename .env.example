# Copy to .env only for local development. Never commit real credentials.

# Required only for the corresponding local or Daytona runner.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DAYTONA_API_KEY=

# Optional local/proxy endpoints for agent providers. Use these when routing
# agents through an OpenAI-compatible or Anthropic-compatible gateway. Some
# gateways use the auth fields for routing, purpose, or team attribution.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
OPENAI_BASE_URL=
CODEX_AUTH_JSON_PATH=

# Optional host proxy used when a local LLM gateway is reachable from the host
# but not directly reachable from task containers. Start it with
# `npm run llm-proxy -- --env-file <path>`.
LOCAL_LLM_PROXY_TARGET_HOST=
LOCAL_LLM_PROXY_UPSTREAM_HOST=
LOCAL_LLM_PROXY_UPSTREAM_PORT=
LOCAL_LLM_PROXY_PORT=
LOCAL_LLM_PROXY_LISTEN_HOST=

# Alternative Daytona authentication. Set both values together instead of
# DAYTONA_API_KEY when using token-based authentication.
DAYTONA_JWT_TOKEN=
DAYTONA_ORGANIZATION_ID=

# Optional Harbor Hub authentication for non-interactive uploads.
HARBOR_API_KEY=

# Optional override for the Tempo MCP efficiency suite upstream endpoint.
TEMPO_MCP_EVAL_URL=
