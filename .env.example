# Copy to .env only for local development. Never commit real credentials.

# Required only for the corresponding local or Daytona runner.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DAYTONA_API_KEY=

# Alternative Daytona authentication. Set both values together instead of
# DAYTONA_API_KEY when using token-based authentication.
DAYTONA_JWT_TOKEN=
DAYTONA_ORGANIZATION_ID=

# Optional Harbor Hub authentication for non-interactive uploads.
HARBOR_API_KEY=

# Optional override for the Tempo MCP efficiency suite upstream endpoint.
TEMPO_MCP_EVAL_URL=
