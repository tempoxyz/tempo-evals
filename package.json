{
  "name": "tempo-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:prepare": "uv run python scripts/prepare_docs_bundle.py",
    "docs:check": "uv run python scripts/prepare_docs_bundle.py --check",
    "sync": "uv run python scripts/run_benchmark.py sync",
    "dataset": "uv run python scripts/run_benchmark.py dataset",
    "build-base": "uv run python scripts/run_benchmark.py build-base",
    "base-image:ref": "uv run python scripts/base_image.py ref",
    "mcp:verify": "uv run python scripts/verify_tempo_mcp.py",
    "bench": "uv run python scripts/run_benchmark.py local-agent",
    "bench:model": "uv run python scripts/run_benchmark.py model",
    "bench:local:tempo": "uv run python scripts/run_benchmark.py local-oracle-dev --no-sync --task-suite tempo",
    "bench:local:mpp": "uv run python scripts/run_benchmark.py local-oracle-dev --no-sync --task-suite mpp",
    "bench:local:mcp": "uv run python scripts/run_benchmark.py local-agent --task-suite tempo-mcp --profile mcp-both",
    "bench:local:all": "uv run python scripts/run_benchmark.py local-oracle-dev --no-sync --task-suite all",
    "bench:local:oracle": "uv run python scripts/run_benchmark.py local-oracle",
    "bench:local:oracle:dev": "uv run python scripts/run_benchmark.py local-oracle-dev --no-sync",
    "bench:local:one": "uv run python scripts/run_benchmark.py local-oracle-dev --no-sync --concurrency 1",
    "bench:local:agent": "uv run python scripts/run_benchmark.py local-agent",
    "bench:local:agent:dev": "uv run python scripts/run_benchmark.py local-agent-dev",
    "bench:daytona:oracle": "uv run python scripts/run_benchmark.py daytona-oracle",
    "bench:daytona:agent": "uv run python scripts/run_benchmark.py daytona-agent",
    "bench:daytona:agent:dev": "uv run python scripts/run_benchmark.py daytona-agent-dev",
    "bench:production": "uv run python scripts/run_benchmark.py production-daytona",
    "results:export": "uv run python scripts/export_results.py",
    "results:compare": "uv run python scripts/compare_mcp_results.py",
    "harbor:view": "uv run harbor view jobs",
    "check": "npm run check:scripts && npm run test:results && npm run test:tempo-verifier && npm run test:mcp-bridge && npm run check:shell && npm run task:lint && npm run check:docs && npm run check:format && npm run check:lint",
    "check:dataset": "uv run python scripts/run_benchmark.py check-dataset",
    "check:docs": "npm run docs:prepare && npm run docs:check",
    "check:generated": "uv run python scripts/run_benchmark.py check-generated",
    "task:new": "uv run python scripts/task_new.py",
    "task:lint": "uv run python scripts/task_lint.py",
    "check:format": "uv run ruff format --check .",
    "check:lint": "uv run ruff check .",
    "check:shell": "find shared -name '*.sh' -exec uv run shellcheck --severity=warning {} +",
    "check:scripts": "uv run python -m compileall -q scripts",
    "test:results": "uv run python -m unittest discover -s scripts -p '*_test.py'",
    "test:mcp-bridge": "node --test shared/tempo/mcp-bridge/server.test.mjs",
    "test:tempo-verifier": "npm ci --ignore-scripts --no-audit --no-fund --prefix shared/tempo/verifier && npm test --prefix shared/tempo/verifier",
    "clean": "uv run python scripts/run_benchmark.py clean",
    "clean:jobs": "uv run python scripts/run_benchmark.py clean-jobs"
  }
}
